NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://user:password@localhost:5432/chatapp
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatapp
DB_USERNAME=user
DB_PASSWORD=password

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=your_super_secret_access_token_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_here

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

SIGNATURE_ALGORITHM=RSA-SHA256
SIGNATURE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
SIGNATURE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=chat-attachments
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

CORS_ORIGIN=http://localhost:3001

MAX_FILE_SIZE=52428800
MAX_REQUEST_SIZE=10mb
